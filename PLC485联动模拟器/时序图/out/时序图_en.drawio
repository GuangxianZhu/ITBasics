erticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1032" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p6-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1132" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p6-18" value="Reset ON (~5 s)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1132" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p6-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1232" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p6-20" value="Reset OFF · check" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1232" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p6-21" value="⑧" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1332" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p6-22" value="Idle" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p6-table"><mxGeometry x="1332" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p6-23" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p6-table"><mxGeometry x="112" y="160" width="520" height="30" as="geometry"/></mxCell><mxCell id="p6-24" value="Run / flow" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p6-table"><mxGeometry x="112" y="160" width="180" height="30" as="geometry"/></mxCell><mxCell id="p6-25" value="[I][?] OFF after a major fault (see ※6)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p6-table"><mxGeometry x="292" y="160" width="340" height="30" as="geometry"/></mxCell><mxCell id="p6-26" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p6-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="190" as="sourcePoint"/><mxPoint x="1432" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-27" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p6-table"><mxGeometry x="112" y="190" width="520" height="30" as="geometry"/></mxCell><mxCell id="p6-28" value="Write temp" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p6-table"><mxGeometry x="112" y="190" width="180" height="30" as="geometry"/></mxCell><mxCell id="p6-29" value="[?] writes 25.0 when stopping" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;