" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_in;sig=写温度;kind=on;fr=1;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="242" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-101" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=写应答;kind=on;fr=1;fillColor=#7030a0;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="268" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-102" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=写应答;kind=on;fr=1;fillColor=#7030a0;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="268" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-103" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=温度安定 DO;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="813" y="294" width="108" height="18" as="geometry"/></mxCell><mxCell id="p3-104" value="① ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_out;sig=通水;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="320" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-105" value="③ OFF" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=8;spacing=0;tl=bar;zone=su_out;sig=通水;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="320" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-106" value="② 50.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=6.8;spacing=0;tl=bar;zone=su_out;sig=温度;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="346" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-107" value="① 25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=6.8;spacing=0;tl=bar;zone=su_out;sig=温度;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="346" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-108" value="③ ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_out;sig=运转;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="372" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-109" value="② OFF" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=8;spacing=0;tl=bar;zone=su_out;sig=运转;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="372" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-110" value="状态" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="533" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-111" value="读回" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="623" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-112" value="状态" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="743" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-113" value="状态" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="813" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-114" value="读回" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="923" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-115" value="状态" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1003" y="398" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-116" value="应答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="533" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-117" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=6.8;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-118" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="623" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-119" value="应答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="743" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-120" value="应答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="813" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-121" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=6.8;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-122" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="923" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-123" value="应答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1003" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p3-124" value="运转中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="450" width="298" height="18" as="geometry"/></mxCell><mxCell id="p3-125" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="483" y="476" width="98" height="18" as="geometry"/></mxCell><mxCell id="p3-126" value="50.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="583" y="476" width="298" height="18" as="geometry"/></mxCell><mxCell id="p3-127" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="883" y="476" width="198" height="18" as="geometry"/></mxCell><mxCell id="p3-128" value="安定" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=安定（内部）;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="773" y="502" width="108" height="18" as="geometry"/></mxCell><mxCell id="p3-129" value="【注记】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="10" y="542" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3-130" value="※1 往温水器的顺序：开始 = 通水 ON → 温度 50.0 → 运转 ON；停止 = 温度 25.0 → 运转 OFF → 通水 OFF【定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="564" width="1074" height="20" as="geometry"/></mxCell><mxCell id="p3-131" value="※2 PLC 等运转 ON 才发通水：温水器「通水 ON + 运转 OFF」会开入口阀流常温水【定】；运转中、停止中通水 OFF 都无效，停止中运转 OFF 无效【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="584" width="1074" height="20" as="geometry"/></mxCell><mxCell id="p3-132" value="※3 ACK 只表示收到【推】。发完 3 帧马上读回目标温度和状态核对；不一致就重发，3 次还不对按通信异常处理（重故障）【P，暂定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="604" width="1074" height="20" as="geometry"/></mxCell><mxCell id="p3-133" value="※4 PLC 用自带的 Modbus 从站功能，清洗机的写马上就有应答（不等温水器）；程序看到值变了再发 3 帧（合计约 0.2～0.3 s）【P】。所以清洗机拿到应答不代表温水器收到了，转发失败按通信异常报重故障（见 4-2）。图上请求和应答画在同一时刻。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="624" width="1074" height="38" as="geometry"/></mxCell><mxCell id="p3-134" value="※5 手动模式下清洗机投入开始就开投入阀，不等安定【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="662" width="1074" height="20" as="geometry"/></mxCell><mxCell id="p3-135" value="※6 安定 DO 跟着状态更新：ON 最多晚 3 s（等下一次状态读出）；停的时候发完 3 帧马上读回，OFF 跟着读回走【P】。读回 = 目标温度 + 装置状态两帧，图上合成一格。运转 OFF 后安定位清零是按位定义推断的，待确认。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="682" width="1074" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-2" name="2-2 自动：准备开始 → 等安定 → 投入 → 准备停止"><mxGraphModel dx="1302" dy="592" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1302" pageHeight="592" math="0" shadow="0"><root><mxCell id="p4-0"/><mxCell id="p4-table" value="表格" style="locked=1;" parent="p4-0"/><mxCell id="p4-sig" value="信号" parent="p4-0"/><mxCell id="p4-1" value="2-2  自动：准备开始 → 等安定 → 投入 → 准备停止" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="10" y="8" width="1282" height="30" as="geometry"/></mxCell><mxCell id="p4-2" value="这张图回答：自动模式下清洗机等安定再投入，安定 DO 晚到会不会拖慢节拍" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="40" width="1282" height="24" as="geometry"/></mxCell><mxCell id="p4-3" value="来源：【推】Claude 按通用架构推理　【IO】假想的 IO 分配　【P】PLC 本方案　【未】还没定　【定】用户已确认　｜　红虚线框「无」= 没应答" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="66" width="1282" height="22" as="geometry"/></mxCell><mxCell id="p4-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="0" y="96" width="92" height="64" as="geometry"/></mxCell><mxCell id="p4-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="92" y="96" width="140" height="64" as="geometry"/></mxCell><mxCell id="p4-6" value="备考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="232" y="96" width="250" height="64" as="geometry"/></mxCell><mxCell id="p4-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="482" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-8" value="待机" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="482" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="582" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-10" value="准备开始" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="582" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="682" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-12" value="运转 ON（延时后）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="682" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="782" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-14" value="升温 → 安定" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="782" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="882" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-16" value="投入开始" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="882" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="982" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-18" value="投入停止" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="982" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1082" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-20" value="准备停止" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1082" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-21" value="⑧" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1182" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-22" value="待机" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1182" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-23" value="" style="rounded=0;fillColor=#ededed;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="92" y="160" width="390" height="26" as="geometry"/></mxCell><mxCell id="p4-24" value="Out 侧排水阀" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="92" y="160" width="140" height="26" as="geometry"/></mxCell><mxCell id="p4-25" value="【推】准备开始开 / 投入开始延时后关 / 投入停止开 / 准备停止延时后关" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="232" y="160" width="250" height="26" as="geometry"/></mxCell><mxCell id="p4-26" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p4-table"><mxGeometry relative="1" as="geometry"><mxPoint x="482" y="186" as="sourcePoint"/><mxPoint x="1282" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-27" value="" style="rounded=0;fillColor=#ededed;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="92" y="186" width="390" height="26" as="geometry"/></mxCell><mxCell id="p4-28" value="投入阀" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="92" y="186" width="140" height="26" as="geometry"/></mxCell><mxCell id="p4-29" value="【推】【定】等安定 ON 才进投入开始；投入停止延时后关" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="232" y="186" width="250" height="26" as="geometry"/></mxCell><mxCell id="p4-30" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p4-table"><mxGeometry relative="1" as="geometry"><mxPoint x="482" y="212" as="sourcePoint"/><mxPoint x="1282" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-31" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="92" y="212" width="390" height="26" as="geometry"/></mxCell><mxCell id="p4-32" value="运转" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="92" y="212" width="140" height="26" as="geometry"/></mxCell><mxCell id="p4-33" value="【推】准备开始延时后 ON / 准备停止 OFF" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="232" y="212" width="250" hei