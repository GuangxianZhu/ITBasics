" height="28" as="geometry"/></mxCell><mxCell id="p1-37" value="【P】キャッシュで応答。温水器の起動前は全 0" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p1-table"><mxGeometry x="260" y="300" width="300" height="28" as="geometry"/></mxCell><mxCell id="p1-38" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p1-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="328" as="sourcePoint"/><mxPoint x="960" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-39" value="" style="rounded=0;fillColor=#fbe4d5;strokeColor=#ffffff;" vertex="1" parent="p1-table"><mxGeometry x="100" y="328" width="460" height="28" as="geometry"/></mxCell><mxCell id="p1-40" value="リモート電源投入" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p1-table"><mxGeometry x="100" y="328" width="160" height="28" as="geometry"/></mxCell><mxCell id="p1-41" value="【IO】PLC が転送（IO 出力）" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p1-table"><mxGeometry x="260" y="328" width="300" height="28" as="geometry"/></mxCell><mxCell id="p1-42" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p1-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="356" as="sourcePoint"/><mxPoint x="960" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-43" value="" style="rounded=0;fillColor=#fbe4d5;strokeColor=#ffffff;" vertex="1" 