Geometry x="845" y="372" width="32" height="18" as="geometry"/></mxCell><mxCell id="p8-129" value="补读" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="1145" y="372" width="32" height="18" as="geometry"/></mxCell><mxCell id="p8-130" value="错误 · 蜂鸣" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=8.5;spacing=0;tl=bar;zone=su_out;sig=复位;kind=on;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="1083" y="398" width="58" height="18" as="geometry"/></mxCell><mxCell id="p8-131" value="ACK ×2" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="783" y="424" width="58" height="18" as="geometry"/></mxCell><mxCell id="p8-132" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="845" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p8-133" value="ACK ×2" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="1083" y="424" width="58" height="18" as="geometry"/></mxCell><mxCell id="p8-134" value="正常" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="1145" y="424" width="32" height="18" as="geometry"/></mxCell><mxCell id="p8-135" value="运转中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="483" y="450" width="298" height="18" as="geometry"/></mxCell><mxCell id="p8-136" value="断线" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=清洗机断线;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p8-sig"><mxGeometry x="783" y="476" width="208" height="18" as="geometry"/></mxCell><mxCell id="p8-137" value="【注记】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p8-table"><mxGeometry x="10" y="516" width="200" height="20" as="geometry"/></mxCell><mxCell id="p8-138" value="※1 清洗机读报警失败 3 次只报「报警读取异常」，只显示、不停机【推】。所以要靠 PLC 自己判断线、让温水器停【P】。斜线格「无」紧跟在请求后面，表示清洗机等到超时才读下一次。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p8-table"><mxGeometry x="14" y="538" width="1274" height="20" as="geometry"/></mxCell><mxCell id="p8-139" value="※2 PLC 判断线的时间：暂定 5 s（500 ms × 10），还没定。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p8-table"><mxGeometry x="14" y="558" width="1274" height="20" as="geometry"/></mxCell><mxCell id="p8-140" value="※3 断线期间清洗机要是写温度（投入开始 / 停止），会报「温度设定异常」→ 温水停止【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p8-table"><mxGeometry x="14" y="578" width="1274" height="20" as="geometry"/></mxCell><mxCell id="p8-141" value="※4 两边断线都要复位：线修好了也要复位才清重故障 DO【P】。清洗机自己的「报警读取异常」在画面上无条件解除【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p8-table"><mxGeometry x="14" y="598" width="1274" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-4-4" name="4-4 PLC 自己断电 / 停止 → 重启 → 复位"><mxGraphModel dx="1302" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1302" pageHeight="760" math="0" shadow="0"><root><mxCell id="p9-0"/><mxCell id="p9-table" value="表格" style="locked=1;" parent="p9-0"/><mxCell id="p9-sig" value="信号" parent="p9-0"/><mxCell id="p9-1" value="4-4  PLC 自己断电 / 停止 → 重启 → 复位" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p9-table"><mxGeometry x="10" y="8" width="1282" height="30" as="geometry"/></mxCell><mxCell id="p9-2" value="这张图回答：PLC 断电或停止运行时，清洗机和温水器各会怎样；PLC 重新起来以后怎么恢复" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="10" y="40" width="1282" height="24" as="geometry"/></mxCell><mxCell id="p9-3" value="来源：【推】Claude 按通用架构推理　【IO】假想的 IO 分配　【P】PLC 本方案　【未】还没定　【定】用户已确认　｜　红虚线框「无」= 没应答" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="10" y="66" width="1282" height="22" as="geometry"/></mxCell><mxCell id="p9-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p9-table"><mxGeometry x="0" y="96" width="92" height="64" as="geometry"/></mxCell><mxCell id="p9-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p9-table"><mxGeometry x="92" y="96" width="140" height="64" as="geometry"/></mxCell><mxCell id="p9-6" value="备考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p9-table"><mxGeometry x="232" y="96" width="250" height="64" as="geometry"/></mxCell><mxCell id="p9-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="482" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-8" value="供水中" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="482" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="582" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-10" value="PLC 断电 / 停止" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="582" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="682" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-12" value="清洗机看到故障 · 停" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="682" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="782" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-14" value="清洗机读报警失败" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="782" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="882" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-16" value="PLC 重新运行" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="882" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="982" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-18" value="PLC 读温水器 · 补发停止" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="982" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="1082" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p9-20" value="复位 ON（约 5 s）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p9-table"><mxGeometry x="1082" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p9-21" value=