"388" width="32" height="20" as="geometry"/></mxCell><mxCell id="p1-113" value="シリアルOK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=6;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="761" y="416" width="32" height="20" as="geometry"/></mxCell><mxCell id="p1-114" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="801" y="416" width="32" height="20" as="geometry"/></mxCell><mxCell id="p1-115" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="836" y="416" width="32" height="20" as="geometry"/></mxCell><mxCell id="p1-116" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="891" y="416" width="32" height="20" as="geometry"/></mxCell><mxCell id="p1-117" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=控制电源;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="561" y="444" width="398" height="20" as="geometry"/></mxCell><mxCell id="p1-118" value="起動中（30 s）" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=gray;fillColor=#9ca3af;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="561" y="472" width="198" height="20" as="geometry"/></mxCell><mxCell id="p1-119" value="通信可能" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="761" y="472" width="198" height="20" as="geometry"/></mxCell><mxCell id="p1-120" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p1-sig"><mxGeometry x="801" y="500" width="158" height="20" as="geometry"/></mxCell><mxCell id="p1-121" value="30 s 待ち（フレーム送信なし）" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=启动等待;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p1-sig"><mxGeometry x="561" y="528" width="198" height="20" as="geometry"/></mxCell><mxCell id="p1-122" value="【注記】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p1-table"><mxGeometry x="10" y="570" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1-123" value="※1 洗浄機は初期化の温度書込に 3 回応答がなければ「通信初期化異常」を出し、画面解除後に書き直す【推】。PLC は内蔵の Modbus スレーブ機能を使うので、書込を受けたら即応答して値をキャッシュに入れる。温水器が起動しているかどうかは関係なく、温水器が起動してから転送する【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="592" width="952" height="38" as="geometry"/></mxCell><mxCell id="p1-124" value="※2 温水器は「通電 30 s 後から通信可能」【推】。リモート電源の投入 / 遮断は洗浄機から PLC に入り、PLC が温水器へ出力する【IO】。そのため PLC は投入を転送した瞬間から 30 s を計り、その間フレームは一切送らない【P】。（以前は通水 ON を起点にしていた。両信号は同時に ON する【定】ので、リモート電源そのものを起点にした方が直接的で、結果は同じ。）" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="630" width="952" height="56" as="geometry"/></mxCell><mxCell id="p1-125" value="※3 待っている間も洗浄機はアラームを読みに来るので、PLC は全 0（正常扱い）を返す。30 s 経過後に 3 回読んで全部無応答なら、初めて通信異常として扱う（ラッチ、要リセット）【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="686" width="952" height="38" as="geometry"/></mxCell><mxCell id="p1-126" value="※4 初回の状態応答でシリアルモードか確認する（温水器パネルでローカル / リモート / シリアルを切替可能）【推】。シリアルでなければ重故障【P・決定済】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="724" width="952" height="20" as="geometry"/></mxCell><mxCell id="p1-127" value="※5 ACK は「受信した」という意味だけで、実行結果は確認コマンドで読み戻して照合する【推】。通水 IO が ON になっても PLC はまだ通水を転送せず、運転 ON を待って送る（2-1 参照）。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="744" width="952" height="38" as="geometry"/></mxCell><mxCell id="p1-128" value="※6 重故障 / 軽故障 DO は b接点：PLC プログラムが動けば「正常」（接点閉）を出力する。PLC が洗浄機より遅く起動すると、洗浄機は電源投入直後に故障を見てしまうので、電源投入の順序を確認すること。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="782" width="952" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-1-2" name="1-2 装置終了：リモート電源遮断 → ポーリング停止"><mxGraphModel dx="1080" dy="588" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="588" math="0" shadow="0"><root><mxCell id="p2-0"/><mxCell id="p2-table" value="テーブル" style="locked=1;" parent="p2-0"/><mxCell id="p2-sig" value="信号" parent="p2-0"/><mxCell id="p2-1" value="1-2  装置終了：リモート電源遮断 → ポーリング停止" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="10" y="8" width="1060" height="30" as="geometry"/></mxCell><mxCell id="p2-2" value="この図で答えること：温水器の電源が直接切られたとき、PLC がそれを断線と判定しないようにするには" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="10" y="40" width="1060" height="24" as="geometry"/></mxCell><mxCell id="p2-3" value="凡例：【推】洗浄機・温水器側の前提　【IO】IO 割付　【P】PLC 本案　【未】未定　【定】確定　｜　赤破線枠「無」= 応答なし" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="10" y="66" width="1060" height="26" as="geometry"/></mxCell><mxCell id="p2-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="0" y="96" width="100" height="64" as="geometry"/></mxCell><mxCell id="p2-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="100" y="96" width="160" height="64" as="geometry"/></mxCell><mxCell id="p2-6" value="備考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="260" y="96" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="560" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-8" value="待機" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="560" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="660" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-10" value="装置終了&#xa;（リモート電源遮断）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="660" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="760" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-12" value="温水器 電源断中" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="760" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="860" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-14" value="次の装置起動&#xa;（リモート電源投入）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="860" y="122" width="100" height="38" as="geometry"/></mxCell><