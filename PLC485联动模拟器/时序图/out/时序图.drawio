p;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="883" y="424" width="98" height="18" as="geometry"/></mxCell><mxCell id="p2-101" value="【注记】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="10" y="464" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2-102" value="※1 远程电源切断经过 PLC【IO】，PLC 转发的同时停轮询、不判通信异常【P，已定】。通水和它同时 OFF【定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="486" width="974" height="20" as="geometry"/></mxCell><mxCell id="p2-103" value="※2 下次远程电源投入从头按 1-1 走：等 30 s 再开始通信。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="506" width="974" height="20" as="geometry"/></mxCell><mxCell id="p2-104" value="※3 投入期间断线照常判通信异常（见 4-2）。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="526" width="974" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-1" name="2-1 手动：投入开始 → 安定 → 投入停止"><mxGraphModel dx="1102" dy="740" grid="1" gridSize="10" guides="1" t