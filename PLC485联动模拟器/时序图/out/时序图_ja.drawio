8" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="701" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-119" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="821" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-120" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="891" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-121" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=7.3;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="961" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-122" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1001" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-123" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1081" y="444" width="32" height="20" as="geometry"/></mxCell><mxCell id="p3-124" value="運転中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="661" y="472" width="298" height="20" as="geometry"/></mxCell><mxCell id="p3-125" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="561" y="500" width="98" height="20" as="geometry"/></mxCell><mxCell id="p3-126" value="50.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="661" y="500" width="298" height="20" as="geometry"/></mxCell><mxCell id="p3-127" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="961" y="500" width="198" height="20" as="geometry"/></mxCell><mxCell id="p3-128" value="安定" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=安定（内部）;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="851" y="528" width="108" height="20" as="geometry"/></mxCell><mxCell id="p3-129" value="【注記】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="10" y="570" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3-130" value="※1 温水器への順序：開始 = 通水 ON → 温度 50.0 → 運転 ON、停止 = 温度 25.0 → 運転 OFF → 通水 OFF【定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="592" width="1152" height="20" as="geometry"/></mxCell><mxCell id="p3-131" value="※2 PLC は運転 ON を待ってから通水を送る：温水器は「通水 ON + 運転 OFF」で入口弁を開けて常温水を流すため【定】。運転中・停止中の通水 OFF はどちらも無効、停止中の運転 OFF も無効【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="612" width="1152" height="20" as="geometry"/></mxCell><mxCell id="p3-132" value="※3 ACK は受信しただけ【推】。3 フレーム送信後すぐ目標温度と状態を読み戻して照合し、不一致なら再送、3 回合わなければ通信異常（重故障）として扱う【P・暫定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="632" width="1152" height="20" as="geometry"/></mxCell><mxCell id="p3-133" value="※4 PLC は内蔵の Modbus スレーブ機能を使うので、洗浄機の書込にはすぐ応答する（温水器を待たない）。プログラムが値の変化を見てから 3 フレームを送る（合計約 0.2～0.3 s）【P】。つまり洗浄機が応答を受けても温水器が受信したとは限らず、転送失敗は通信異常として重故障を出す（4-2 参照）。図では要求と応答を同じ時刻に描いている。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="652" width="1152" height="38" as="geometry"/></mxCell><mxCell id="p3-134" value="※5 手動モードでは洗浄機は投入開始で投入弁を開け、安定を待たない【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="690" width="1152" height="20" as="geometry"/></mxCell><mxCell id="p3-135" value="※6 安定 DO は状態の更新に従う：ON は最大 3 s 遅れる（次の状態読出を待つ）。停止時は 3 フレーム送信後すぐ読み戻し、OFF は読み戻しに従う【P】。読み戻し = 目標温度 + 装置状態の 2 フレームで、図では 1 マスにまとめている。運転 OFF 後に安定 bit がクリアされる点は要確認。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="710" width="1152" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-2" name="2-2 自動：準備開始 → 安定待ち → 投入 → 準備停止"><mxGraphModel dx="1380" dy="616" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="616" math="0" shadow="0"><root><mxCell id="p4-0"/><mxCell id="p4-table" value="テーブル" style="locked=1;" parent="p4-0"/><mxCell id="p4-sig" value="信号" parent="p4-0"/><mxCell id="p4-1" value="2-2  自動：準備開始 → 安定待ち → 投入 → 準備停止" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="10" y="8" width="1360" height="30" as="geometry"/></mxCell><mxCell id="p4-2" value="この図で答えること：自動モードでは洗浄機は安定を待ってから投入する。安定 DO が遅れるとタクトが延びるか" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="40" width="1360" height="24" as="geometry"/></mxCell><mxCell id="p4-3" value="凡例：【推】洗浄機・温水器側の前提　【IO】IO 割付　【P】PLC 本案　【未】未定　【定】確定　｜　赤破線枠「無」= 応答なし" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="66" width="1360" height="26" as="geometry"/></mxCell><mxCell id="p4-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="0" y="96" width="100" height="64" as="geometry"/></mxCell><mxCell id="p4-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="100" y="96" width="160" height="64" as="geometry"/></mxCell><mxCell id="p4-6" value="備考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="260" y="96" width="300" height="64" as="geometry"/></mxCell><mxCell id="p4-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="560" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-8" value="待機" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="560" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="660" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-10" value="準備開始" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="660" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="760" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-12" value="運転 ON（遅延後）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="760" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="860" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-14" value="昇温 → 安定" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="860" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="960" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-16" value="投入開始" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="960" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1060" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p4-18" value="投入停止" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p4-table"><mxGeometry x="1060" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p4-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSi