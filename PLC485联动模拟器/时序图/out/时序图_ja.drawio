ffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1127" y="472" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-142" value="再読出" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=8.7;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1223" y="472" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-143" value="停止 ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=6.3;spacing=0;tl=bar;zone=su_out;sig=停止 3 帧;kind=on;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1096" y="500" width="28" height="20" as="geometry"/></mxCell><mxCell id="p9-144" value="エラー・ブザー" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=7.4;spacing=0;tl=bar;zone=su_out;sig=复位;kind=on;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1161" y="528" width="58" height="20" as="geometry"/></mxCell><mxCell id="p9-145" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="611" y="556" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-146" value="応答" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1061" y="556" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-147" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=6.1;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1096" y="556" width="28" height="20" as="geometry"/></mxCell><mxCell id="p9-148" value="一致" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1127" y="556" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-149" value="ACK ×2" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1161" y="556" width="58" height="20" as="geometry"/></mxCell><mxCell id="p9-150" value="正常" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="1223" y="556" width="32" height="20" as="geometry"/></mxCell><mxCell id="p9-151" value="運転継続（止められない）" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="561" y="584" width="533" height="20" as="geometry"/></mxCell><mxCell id="p9-152" value="RUN" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=PLC 运行;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="561" y="612" width="98" height="20" as="geometry"/></mxCell><mxCell id="p9-153" value="STOP / 電源断" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=PLC 运行;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="661" y="612" width="298" height="20" as="geometry"/></mxCell><mxCell id="p9-154" value="RUN" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=PLC 运行;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p9-sig"><mxGeometry x="961" y="612" width="398" height="20" as="geometry"/></mxCell><mxCell id="p9-155" value="【注記】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p9-table"><mxGeometry x="10" y="654" width="200" height="20" as="geometry"/></mxCell><mxCell id="p9-156" value="※1 故障 DO は b接点：PLC が電源断・停止すると接点が開き、洗浄機はすぐ重故障と軽故障を見る。PLC 側で何もする必要はない。図は論理で描いている（赤 = アラーム）。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p9-table"><mxGeometry x="14" y="676" width="1352" height="20" as="geometry"/></mxCell><mxCell id="p9-157" value="※2 PLC 停止後の洗浄機側：アラーム読出失敗 3 回 →「アラーム読出異常」表示のみ、温度書込失敗 3 回 →「温度設定異常」→ 温水停止【推】。要求直後の「無」枠はタイムアウトまで待つことを表す。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p9-table"><mxGeometry x="14" y="696" width="1352" height="20" as="geometry"/></mxCell><mxCell id="p9-158" value="※3 温水器には通信ウォッチドッグがなく、PLC が止まっても最後の状態のまま運転を続ける。リモート電源の投入 / 遮断も PLC を経由する【IO】ので、PLC 停止中は洗浄機が電源を切っても温水器に届かない。非常停止はなく、リスクアセスメントに記載する（決定済、この項目は追記が必要）。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p9-table"><mxGeometry x="14" y="716" width="1352" height="38" as="geometry"/></mxCell><mxCell id="p9-159" value="※4 PLC 再起動時にはリモート電源は既に投入済：温水器は通電しているので 30 s 待たずにすぐ読む【P】。PLC 運転再開後：まず温水器の状態を 1 回読み、洗浄機の現在の運転 / 通水に合わせて停止を再送する。故障 DO はアラームのまま保持し、洗浄機のアラーム読出にも「アラーム」を返し、洗浄機のリセットで解除する（PLC 自身の停止も断線扱いで、同じくリセットが必要）【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p9-table"><mxGeometry x="14" y="754" width="1352" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
