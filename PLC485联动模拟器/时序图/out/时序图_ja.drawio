iryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="260" y="356" width="300" height="28" as="geometry"/></mxCell><mxCell id="p9-54" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p9-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="384" as="sourcePoint"/><mxPoint x="1360" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-55" value="" style="rounded=0;fillColor=#e9e0f2;strokeColor=#ffffff;" vertex="1" parent="p9-table"><mxGeometry x="100" y="384" width="460" height="28" as="geometry"/></mxCell><mxCell id="p9-56" value="重故障 DO" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="100" y="384" width="160" height="28" as="geometry"/></mxCell><mxCell id="p9-57" value="【P】b接点：PLC 停止 = 接点開 = アラーム。再起動後もリセットまで保持" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="260" y="384" width="300" height="28" as="geometry"/></mxCell><mxCell id="p9-58" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p9-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="412" as="sourcePoint"/><mxPoint x="1360" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-59" value="" style="rounded=0;fillColor=#e9e0f2;strokeColor=#ffffff;" vertex="1" parent="p9-table"><mxGeometry x="100" y="412" width="460" height="28" as="geometry"/></mxCell><mxCell id="p9-60" value="軽故障 DO" sty