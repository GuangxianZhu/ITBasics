l><mxCell id="p2-93" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=控制电源;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="633" y="404" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-94" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=控制电源;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="933" y="404" width="198" height="22" as="geometry"/></mxCell><mxCell id="p2-95" value="Booting" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=gray;fillColor=#9ca3af;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="933" y="434" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-96" value="Comm ready" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="1033" y="434" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-97" value="Polling" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="633" y="464" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-98" value="Stopped (equipment end)" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=gray;fillColor=#9ca3af;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="733" y="464" width="198" height="22" as="geometry"/></mxCell><mxCell id="p2-99" value="Wait 30 s" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="933" y="464" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-100" value="Polling" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="1033" y="464" width="98" height="22" as="geometry"/></mxCell><mxCell id="p2-101" value="[Notes]" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="10" y="508" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2-102" value="※1 Remote power OFF passes through the PLC [IO]; while forwarding it, the PLC stops polling and does not flag a comm error [P, decided]. Flow turns OFF at the same time [OK]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="530" width="1124" height="20" as="geometry"/></mxCell><mxCell id="p2-103" value="※2 From the next remote power ON, it follows 1-1 again: wait 30 s, then start communicating." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="550" width="1124" height="20" as="geometry"/></mxCell><mxCell id="p2-104" value="※3 A link loss while powered is still flagged as a comm error (see 4-2)." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="570" width="1124" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-1" name="2-1 Manual: supply start → stable → supply stop"><mxGraphModel dx="1252" dy="814" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1252" pageHeight="814" math="0" shadow="0"><root><mxCell id="p3-0"/><mxCell id="p3-table" value="Table" style="locked=1;" parent="p3-0"/><mxCell id="p3-sig" value="Signal" parent="p3-0"/><mxCell id="p3-1" value="2-1  Manual: supply start → stable → supply stop" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="10" y="8" width="1232" height="30" as="geometry"/></mxCell><mxCell id="p3-2" value="This chart answers: When the cleaner turns run ON / OFF, what does the PLC send to the heater, in what order; when does the stable DO change?" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p3-table"><mxGeometry x="10" y="40" width="1232" height="24" as="geometry"/></mxCell><mxCell id="p3-3" value="Legend: [I] cleaner / heater side premise   [IO] IO assignment   [P] this PLC proposal   [?] not decided   [OK] decided   |   red dashed box &quot;none&quot; = no reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p3-table"><mxGeometry x="10" y="66" width="1232" height="26" as="geometry"/></mxCell><mxCell id="p3-4" value="Group" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="0" y="96" width="112" height="64" as="geometry"/></mxCell><mxCell id="p3-5" value="Signal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="112" y="96" width="180" height="64" as="geometry"/></mxCell><mxCell id="p3-6" value="Notes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="292" y="96" width="340" height="64" as="geometry"/></mxCell><mxCell id="p3-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p3-table"><mxGeometry x="632" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p3-8" value="Idle" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p3-table"><mxGeometry x="632" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p