ily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="1083" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p4-117" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="1183" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p4-118" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="1233" y="434" width="58" height="22" as="geometry"/></mxCell><mxCell id="p4-119" value="Match" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="1295" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p4-120" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="1353" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p4-121" value="Running" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="833" y="464" width="398" height="22" as="geometry"/></mxCell><mxCell id="p4-122" value="Stable" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=安定（内部）;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="953" y="494" width="278" height="22" as="geometry"/></mxCell><mxCell id="p4-123" value="[Notes]" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="10" y="538" width="200" height="20" as="geometry"/></mxCell><mxCell id="p4-124" value="※1 In auto mode the cleaner waits for stable ON before supply start [OK], so a late stable DO directly delays the supply. The read cycle is fixed at 3 s, so it is at most 3 s late." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="560" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p4-125" value="※2 What is sent to the heater is the same as manual (2-1); only the trigger timing differs. It is read back the same way." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="580" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p4-126" value="※3 Valve delay parameters (prep start → run ON, supply start → drain valve close, supply stop → supply valve close) are left out of the chart [I]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="600" width="1424" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-3-1" name="3-1 Two polling cycles: cleaner 500 ms, PLC 3 s"><mxGraphModel dx="1352" dy="546" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1352" pageHeight="546" math="0" shadow="0"><root><mxCell id="p5-0"/><mxCell id="p5-table" value="Table" style="locked=1;" parent="p5-0"/><mxCell id="p5-sig" value="Signal" parent="p5-0"/><mxCell id="p5-1" value="3-1  Two polling cycles: cleaner 500 ms, PLC 3 s" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p5-table"><mxGeometry x="10" y="8" width="1332" height="30" as="geometry"/></mxCell><mxCell id="p5-2" value="This chart answers: The cleaner polls often, the PLC slowly: how do they connect, and how soon does the cleaner see a heater status change?" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p5-table"><mxGeometry x="10" y="40" width="1332" height="24" as="geometry"/></mxCell><mxCell id="p5-3" value="Legend: [I] cleaner / heater side premise   [IO] IO assignment   [P] this PLC proposal   [?] not decided   [OK] decided   |   red dashed box &quot;none&quot; = no reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" paren