x="632" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p6-104" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_in;sig=运转 / 通水;kind=on;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="633" y="164" width="298" height="22" as="geometry"/></mxCell><mxCell id="p6-105" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_in;sig=写温度;kind=on;fr=1;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="933" y="194" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-106" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_in;sig=蜂鸣器复位;kind=on;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1033" y="224" width="33" height="22" as="geometry"/></mxCell><mxCell id="p6-107" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_in;sig=复位;kind=on;fillColor=#2e75b6;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1133" y="254" width="98" height="22" as="geometry"/></mxCell><mxCell id="p6-108" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=重故障 DO;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="833" y="284" width="360" height="22" as="geometry"/></mxCell><mxCell id="p6-109" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=温度安定 DO;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="633" y="314" width="198" height="22" as="geometry"/></mxCell><mxCell id="p6-110" value="Alarm bits" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=读应答（报警 bit）;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="868" y="344" width="325" height="22" as="geometry"/></mxCell><mxCell id="p6-111" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=写应答;kind=on;fr=1;fillColor=#7030a0;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="933" y="374" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-112" value="25.0·Stop" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=8.4;spacing=0;tl=bar;zone=su_out;sig=停止 3 帧;kind=on;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="933" y="404" width="48" height="22" as="geometry"/></mxCell><mxCell id="p6-113" value="Buzzer" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=复位;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1033" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-114" value="Error·Buzzer" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=复位;kind=on;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1133" y="434" width="58" height="22" as="geometry"/></mxCell><mxCell id="p6-115" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="683" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-116" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="833" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-117" value="Rdback" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="985" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-118" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1083" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-119" value="Re-read" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=6.9;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1195" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-120" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1283" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-121" value="Detail" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=8.7;spacing=0;tl=bar;zone=su_out;sig=报警详细;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="868" y="494" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-122" value="OK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="683" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-123" value="Stop err" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=6;spacing=0;tl=bar;zone=su_in;sig=应答;kind=fault;fr=1;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="833" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-124" value="Alarm #" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=6.8;spacing=0;tl=bar;zone=su_in;sig=应答;kind=fault;fr=1;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="868" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-125" value="Reply ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.1;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="933" y="524" width="48" height="22" as="geometry"/></mxCell><mxCell id="p6-126" value="Match" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="985" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-127" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1033" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-128" value="Stop err" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=6;spacing=0;tl=bar;zone=su_in;sig=应答;kind=fault;fr=1;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1083" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-129" value="ACK ×2" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1133" y="524" width="58" height="22" as="geometry"/></mxCell><mxCell id="p6-130" value="OK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1195" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-131" value="OK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1283" y="524" width="32" height="22" as="geometry"/></mxCell><mxCell id="p6-132" value="Alarm" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=报警;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="733" y="554" width="298" height="22" as="geometry"/></mxCell><mxCell id="p6-133" value="Cleared · latched" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=报警;kind=tbd;fillColor=#ffffff;strokeColor=#9ca3af;dashed=1;fontColor=#6b7280;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="1033" y="554" width="98" height="22" as="geometry"/></mxCell><mxCell id="p6-134" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p6-sig"><mxGeometry x="633" y="584" width="98" height="22" as="geometry"/></mxCell><mxCell id="p6-135" value="[Notes]" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p6-table"><mxGeometry x="10" y="628" width="200" height="20" as="geometry"/></mxCell><mxCell id="p6-136" value="※1 Reset is ON for about 5 s; at the moment it turns OFF the cleaner checks that the major fault input and the alarm bits are normal, and clears only if they are [I]. So on the reset rising edge the PLC must: send reset to the heater → do one extra status read right away → clear the DO and bits before OFF [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="650" width="1424" height="38" as="geometry"/></mxCell><mxCell id="p6-137" value="※2 Reset before the cause is removed: the heater still alarms, the DO is not cleared, the check at OFF fails → not cleared [I]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="688" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p6-138" value="※3 A minor fault has the same timing: status &quot;continue error&quot; bit → minor fault DO [I]; the heater keeps heating, the cleaner does not stop, and reset works the same way [I]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="708" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p6-139" value="※4 Alarm detail: the heater's alarm numbers and the alarm bits the cleaner reads use the same numbering, so the PLC maps them directly by number, with no item-by-item table [I]. The detail reply is long (about 0.15 s), so it is read only when an error bit is set [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="728" width="1424" height="38" as="geometry"/></mxCell><mxCell id="p6-140" value="※5 The cleaner has two IOs: reset and buzzer reset [IO]. Buzzer reset → send buzzer reset; reset → send error reset + buzzer reset (the earlier decision is kept) [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="766" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p6-141" value="※6 The cleaner turning off run / flow and writing 25.0 after a major fault: not decided yet." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="786" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p6-142" value="※7 During an alarm the heater has already stopped by itself, so the forwarded 3 stop frames may get a &quot;cannot execute now&quot; NAK [I]. That NAK does not count as a comm failure; the readback decides. Only a &quot;data error&quot; NAK counts [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="806" width="1424" height="20" as="geometry"/></mxCell><mxCell id="p6-143" value="※8 Leak alarms work the same way: the PLC does not turn off run and flow itself; it waits for the cleaner to stop on seeing the major fault (decided). Letting the heater side shut off by itself is also possible, but not used here." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p6-table"><mxGeometry x="14" y="826" width="1424" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-4-2" name="4-2 Heater-side link loss → PLC cuts remote power → reset"><mxGraphModel dx="1552" dy="938" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1552" pageHeight="938" math="0" shadow="0"><root><mxCell id="p7-0"/><mxCell id="p7-table" value="Table" style="locked=1;" parent="p7-0"/><mxCell id="p7-sig" value="Signal" parent="p7-0"/><mxCell id="p7-1" value="4-2  Heater-side link loss → PLC cuts remote power → reset" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p7-table"><mxGeometry x="10" y="8" width="1532" height="30" as="geometry"/></mxCell><mxCell id="p7-2" value="This chart answers: If the PLC–heater link breaks: what does the cleaner see, how does the PLC stop the heater, and how is it cleared after repair?" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="10" y="40" width="1532" height="24" as="geometry"/></mxCell><mxCell id="p7-3" value="Legend: [I] cleaner / heater side premise   [IO] IO assignment   [P] this PLC proposal   [?] not decided   [OK] decided   |   red dashed box &quot;none&quot; = no reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="10" y="66" width="1532" height="26" as="geometry"/></mxCell><mxCell id="p7-4" value="Group" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p7-table"><mxGeometry x="0" y="96" width="112" height="64" as="geometry"/></mxCell><mxCell id="p7-5" value="Signal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p7-table"><mxGeometry x="112" y="96" width="180" height="64" as="geometry"/></mxCell><mxCell id="p7-6" value="Notes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p7-table"><mxGeometry x="292" y="96" width="340" height="64" as="geometry"/></mxCell><mxCell id="p7-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="632" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-8" value="Supplying" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="632" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="732" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-10" value="Link lost · timeout 1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="732" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="832" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-12" value="Timeout 2" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="832" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="932" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-14" value="Timeout 3 = comm error · power cut" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="932" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1032" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-16" value="Cleaner stops" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1032" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1132" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-18" value="Line fixed · equipment restart" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1132" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1232" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-20" value="30 s passed ·&#xa;comm resumes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1232" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-21" value="⑧" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1332" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-22" value="Reset ON (~5 s)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1332" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-23" value="⑨" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1432" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p7-24" value="Reset OFF · check" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p7-table"><mxGeometry x="1432" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p7-25" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="160" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-26" value="Run" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="160" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-27" value="[I] OFF after a major fault" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="160" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-28" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="190" as="sourcePoint"/><mxPoint x="1532" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-29" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="190" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-30" value="Water flow" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="190" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-31" value="[I][?] OFF after a major fault; ON at equipment start" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="190" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-32" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="220" as="sourcePoint"/><mxPoint x="1532" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-33" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="220" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-34" value="Remote power ON" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="220" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-35" value="[IO] equipment restart (the earlier OFF is omitted)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="220" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-36" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="250" as="sourcePoint"/><mxPoint x="1532" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-37" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="250" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-38" value="Write temp" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="250" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-39" value="[?] writes 25.0 when stopping; [I] init writes 25.0 at start" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="250" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-40" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="280" as="sourcePoint"/><mxPoint x="1532" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-41" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="280" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-42" value="Reset" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="280" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-43" value="[I] reset on screen → ON ~5 s → OFF" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontCol