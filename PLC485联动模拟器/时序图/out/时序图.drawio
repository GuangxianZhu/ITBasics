id="p7-168" value="2" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=失败次数;kind=val;fr=1;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p7-sig"><mxGeometry x="727" y="606" width="32" height="18" as="geometry"/></mxCell><mxCell id="p7-169" value="3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=失败次数;kind=val;fr=1;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p7-sig"><mxGeometry x="827" y="606" width="32" height="18" as="geometry"/></mxCell><mxCell id="p7-170" value="异常（锁存）" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=通信异常;kind=fault;fillColor=#c00000;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p7-sig"><mxGeometry x="827" y="632" width="416" height="18" as="geometry"/></mxCell><mxCell id="p7-171" value="等 30 s" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=启动等待;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p7-sig"><mxGeometry x="983" y="658" width="98" height="18" as="geometry"/></mxCell><mxCell id="p7-172" value="【注记】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p7-table"><mxGeometry x="10" y="698" width="200" height="20" as="geometry"/></mxCell><mxCell id="p7-173" value="※1 超时 1000 ms、重试 3 次按常见的串口设定【推】【P】。没应答的请求：斜线格「无」紧跟在请求后面，表示等到超时；失败次数和判断画在同一时刻。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p7-table"><mxGeometry x="14" y="720" width="1374" height="20" as="geometry"/></mxCell><mxCell id="p7-174" value="※2 温水器没有通信看门狗，断线后串口停不下它【推】。远程电源经过 PLC【IO】，所以 PLC 判通信异常的同时自己输出一次远程电源切断，温水器断电停下【P，已定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p7-table"><mxGeometry x="14" y="740" width="1374" height="20" as="geometry"/></mxCell><mxCell id="p7-175" value="※3 切断以后温水器一直断电，PLC 停轮询；要等清洗机下次装置启动（远程电源投入）才重新上电，之后按 1-1 等 30 s【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p7-table"><mxGeometry x="14" y="760" width="1374" height="20" as="geometry"/></mxCell><mxCell id="p7-176" value="※4 两边断线都要复位：通信恢复以后清洗机复位才清重故障 DO。温水器还没起来就复位：PLC 不清，OFF 时检查不过 → 解除失败【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p7-table"><mxGeometry x="14" y="780" width="1374" height="20" as="geometry"/></mxCell><mxCell id="p7-177" value="※5 「数据异常」的 NAK 连续 3 次、写完读回 3 次不一致也算通信异常，一样切电源，报警 bit 不一样；「现在不能执行」的 NAK 不算，以读回为准【P】。断线期间 PLC 照常回清洗机的 Modbus，不让清洗机报 485 异常【P】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p7-table"><mxGeometry x="14" y="800" width="1374" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-4-3" name="4-3 清洗机侧断线 → 复位"><mxGraphModel dx="1302" dy="638" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1302" pageHeight="638" math="0" shadow="0"><root><mxCell id="p8-0"/><mxCell id="p8-table" value="表格" style="locked=1;" parent="p8-0"/><mxCell id="p8-sig" value="信号" parent="p8-0"/><mxCell id="p8-1" value="4-3  清洗机侧断线 → 复位" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p8-table"><mxGeometry x="10" y="8" width="1282" height="30" as="geometry"/></mxCell><mxCell id="p8-2" value="这张图回答：清洗机读写不到 PLC 时，谁让温水器停下来；线修好以后怎么解除" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p8-table"><mxGeometry x="10" y="40" width="1282" height="24" as="geometry"/></mxCell><mxCell id="p8-3" value="来源：【推】Claude 按通用架构推理　【IO】假想的 IO 分配　【P】PLC 本方案　【未】还没定　【定】用户已确认　｜　红虚线框「无」= 没应答" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p8-table"><mxGeometry x="10" y="66" width="1282" height="22" as="geometry"/></mxCell><mxCell id="p8-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p8-table"><mxGeometry x="0" y="96" width="92" height="64" as="geometry"/></mxCell><mxCell id="p8-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p8-table"><mxGeometry x="92" y="96" width="140" height="64" as="geometry"/></mxCell><mxCell id="p8-6" value="备考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p8-table"><mxGeometry x="232" y="96" width="250" height="64" as="geometry"/></mxCell><mxCell id="p8-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="482" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-8" value="供水中" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="482" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="582" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-10" value="断线" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="582" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="682" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-12" value="清洗机读失败" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="682" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="782" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-14" value="PLC 判断线" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="782" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="882" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-16" value="清洗机停" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="882" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-17" value="⑥" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="982" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-18" value="线修好" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="982" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-19" value="⑦" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="1082" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-20" value="复位 ON（约 5 s）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="1082" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-21" value="⑧" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="1182" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p8-22" value="复位 OFF · 检查" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p8-table"><mxGeometry x="1182" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p8-23" value="" style="rounded=0;fillColor=#ededed;strokeColor=#ffffff;" vertex="1" parent="p8-table"><mxGeometry x="92" y="160" width="390" height="26" as="geometry"/></mxCell><mxCell id="p8-24" value="报警读取异常" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p8-table"><mxGeometry x="92" y="160" width="140" height="26" as="geometry"/></mxCell><mxCell id="p8-25" value="【推】读失败 3 次报警，只显示不停机；画面无条件解除" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p8-table"><mxGeometry x="232" y="160" width="250" height="26" as="geometry"/></mxCell><mxCell id="p8-26" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p8-table"><mxGeometry relative="1" as="geometry"><mxPoint x="482" y="186" as="sourcePoint"/><mxPoint x="1282" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p8-27" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p8-table"><mxGeometry x="92" y="186" width="390" height="26" as="geometry"/></mxCell><mxCell id="p8-28" value="读报警" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p8-table"><mxGeometry x="92" y="186" width="140" height="26" as="geometry"/></mxCell><mxCell id="p8-29" value="【推】500 ms；没应答时等超时再读" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p8-table"><mxGeometry x="232" y="186" width="250" height="26" as="geometry"/></mxCell><mxCell id="p8-30" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p8-table"><mxGeometry relative="1" as="geometry"><mxPoint x="482" y="212" as="sourcePoint"/><mxPoint x="1282" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id