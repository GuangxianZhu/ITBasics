ry"/></mxCell><mxCell id="p2-93" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=控制电源;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="561" y="388" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-94" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=控制电源;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="861" y="388" width="198" height="20" as="geometry"/></mxCell><mxCell id="p2-95" value="起動中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=gray;fillColor=#9ca3af;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="861" y="416" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-96" value="通信可能" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=可以通信;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="961" y="416" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-97" value="ポーリング中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="561" y="444" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-98" value="停止（装置終了）" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=gray;fillColor=#9ca3af;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p2-sig"><mxGeometry x="661" y="444" width="198" height="20" as="geometry"/></mxCell><mxCell id="p2-99" value="30 s 待ち" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="861" y="444" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-100" value="ポーリング中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=轮询;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p2-sig"><mxGeometry x="961" y="444" width="98" height="20" as="geometry"/></mxCell><mxCell id="p2-101" value="【注記】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="10" y="486" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2-102" value="※1 リモート電源遮断は PLC を経由する【IO】。PLC は転送と同時にポーリングを止め、通信異常と判定しない【P・決定済】。通水も同時に OFF【定】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="508" width="1052" height="20" as="geometry"/></mxCell><mxCell id="p2-103" value="※2 次のリモート電源投入からは 1-1 と同じ流れ：30 s 待ってから通信を開始する。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="528" width="1052" height="20" as="geometry"/></mxCell><mxCell id="p2-104" value="※3 投入中の断線は通常どおり通信異常と判定する（4-2 参照）。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p2-table"><mxGeometry x="14" y="548" width="1052" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-1" name="2-1 手動：投入開始 → 安定 → 投入停止"><mxGraphModel dx="1180" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="768" math="0" shadow="0"><root><mxCell id="p3-0"/><mxCell id="p3-table" value="テーブル" style="locked=1;" parent="p3-0"/><mxCell id="p3-sig" value="信号" parent="p3-0"/><mxCell id="p3-1" value="2-1  手動：投入開始 → 安定 → 投入停止" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="10" y="8" width="1160" height="30" as="geometry"/></mxCell><mxCell id="p3-2" value="この図で答えること：洗浄機が運転 ON / OFF したとき、PLC は温水器に何をどの順で送るか／安定 DO はいつ変わるか" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p3-table"><mxGeometry x="10" y="40" width="1160" height="24" as="geometry"/></mxCell><mxCell id="p3-3" value="凡例：【推】洗浄機・温水器側の前提　【IO】IO 割付　【P】PLC 本案　【未】未定　【定】確定　｜　赤破線枠「無」= 応答なし" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLef