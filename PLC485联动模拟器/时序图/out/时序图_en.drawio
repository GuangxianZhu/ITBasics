metry relative="1" as="geometry"><mxPoint x="632" y="280" as="sourcePoint"/><mxPoint x="1432" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-39" value="" style="rounded=0;fillColor=#e9e0f2;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="112" y="280" width="520" height="30" as="geometry"/></mxCell><mxCell id="p4-40" value="Write reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="112" y="280" width="180" height="30" as="geometry"/></mxCell><mxCell id="p4-41" value="[P] Modbus slave replies at once (a few ms); value goes to cache" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="292" y="280" width="340" height="30" as="geometry"/></mxCell><mxCell id="p4-42" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p4-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="310" as="sourcePoint"/><mxPoint x="1432" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-43" value="" style="rounded=0;fillColor=#e9e0f2;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="112" y="310" width="520" height="30" as="geometry"/></mxCell><mxCell id="p4-44" value="Temp stable DO" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="112" y="310" width="180" height="30" as="geometry"/></mxCell><mxCell id="p4-45" value="[P] changes only when a status read / readback sees it" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="292" y="310" width="340" height="30" as="geometry"/></mxCell><mxCell id="p4-46" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p4-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="340" as="sourcePoint"/><mxPoint x="1432" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-47" value="" style="rounded=0;fillColor=#fbe4d5;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="112" y="340" width="520" height="30" as="geometry"/></mxCell><mxCell id="p4-48" value="Start: 3 frames" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="112" y="340" width="180" height="30" as="geometry"/></mxCell><mxCell id="p4-49" value="[P] ① flow → ② temp → ③ run" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p4-table"><mxGeometry x="292" y="340" width="340" height="30" as="geometry"/></mxCell><mxCell id="p4-50" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p4-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="370" as="sourcePoint"/><mxPoint x="1432" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-51" value="" style="rounded=0;fillColor=#fbe4d5;strokeColor=#ffffff;" vertex="1" parent="p4-table"><mxGeometry x="112" y="370" width="520" height="30" as="geometry"/></mxCell><mxCell id="p4-