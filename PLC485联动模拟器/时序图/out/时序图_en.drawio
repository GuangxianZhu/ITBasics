/></mxCell><mxCell id="p3-102" value="ACK" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=写应答;kind=on;fr=1;fillColor=#7030a0;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="284" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-103" value="ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=fc_out;sig=温度安定 DO;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="963" y="314" width="108" height="22" as="geometry"/></mxCell><mxCell id="p3-104" value="① ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.6;spacing=0;tl=bar;zone=su_out;sig=通水;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="344" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-105" value="③ OFF" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.6;spacing=0;tl=bar;zone=su_out;sig=通水;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="344" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-106" value="② 50.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.7;spacing=0;tl=bar;zone=su_out;sig=温度;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="374" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-107" value="① 25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.7;spacing=0;tl=bar;zone=su_out;sig=温度;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="374" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-108" value="③ ON" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.6;spacing=0;tl=bar;zone=su_out;sig=运转;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="404" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-109" value="② OFF" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.6;spacing=0;tl=bar;zone=su_out;sig=运转;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="404" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-110" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="683" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-111" value="Rdback" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="773" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-112" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="893" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-113" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="963" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-114" value="Rdback" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1073" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-115" value="Status" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.5;spacing=0;tl=bar;zone=su_out;sig=状态读出 · 读回;kind=on;fr=1;fillColor=#c55a11;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1153" y="434" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-116" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="683" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-117" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.3;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-118" value="Match" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="773" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-119" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="893" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-120" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="963" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-121" value="ACK ×3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=7.3;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-122" value="Match" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1073" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-123" value="Reply" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.7;spacing=0;tl=bar;zone=su_in;sig=应答;kind=on;fr=1;fillColor=#a07800;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="1153" y="464" width="32" height="22" as="geometry"/></mxCell><mxCell id="p3-124" value="Running" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="494" width="298" height="22" as="geometry"/></mxCell><mxCell id="p3-125" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="633" y="524" width="98" height="22" as="geometry"/></mxCell><mxCell id="p3-126" value="50.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="733" y="524" width="298" height="22" as="geometry"/></mxCell><mxCell id="p3-127" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p3-sig"><mxGeometry x="1033" y="524" width="198" height="22" as="geometry"/></mxCell><mxCell id="p3-128" value="Stable" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=安定（内部）;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p3-sig"><mxGeometry x="923" y="554" width="108" height="22" as="geometry"/></mxCell><mxCell id="p3-129" value="[Notes]" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p3-table"><mxGeometry x="10" y="598" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3-130" value="※1 Order to the heater: start = flow ON → temp 50.0 → run ON; stop = temp 25.0 → run OFF → flow OFF [OK]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="620" width="1224" height="20" as="geometry"/></mxCell><mxCell id="p3-131" value="※2 The PLC sends flow only together with run ON: with &quot;flow ON + run OFF&quot; the heater opens its inlet valve and passes room-temperature water [OK]. Flow OFF is ignored while running or stopping, and run OFF is ignored while stopping [I]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="640" width="1224" height="38" as="geometry"/></mxCell><mxCell id="p3-132" value="※3 ACK only means received [I]. Right after the 3 frames the PLC reads back the target temp and status; on a mismatch it resends, and after 3 mismatches it is a comm error (major fault) [P, tentative]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="678" width="1224" height="20" as="geometry"/></mxCell><mxCell id="p3-133" value="※4 The PLC uses its built-in Modbus slave, so the cleaner's write is answered at once (without waiting for the heater); the program sees the value change and then sends the 3 frames (about 0.2–0.3 s in total) [P]. So a reply to the cleaner does not mean the heater got it; a failed forward raises a major fault as a comm error (see 4-2). Requests and replies are drawn at the same moment." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="698" width="1224" height="38" as="geometry"/></mxCell><mxCell id="p3-134" value="※5 In manual mode the cleaner opens the supply valve at supply start without waiting for stable [I]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="736" width="1224" height="20" as="geometry"/></mxCell><mxCell id="p3-135" value="※6 The stable DO follows status updates: ON is up to 3 s late (it waits for the next status read); when stopping, the readback right after the 3 frames turns it OFF [P]. Readback = target temp + equipment status (2 frames), drawn as one cell. That the stable bit clears after run OFF is TBC." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p3-table"><mxGeometry x="14" y="756" width="1224" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-2-2" name="2-2 Auto: prep start → wait for stable → supply → prep stop"><mxGraphModel dx="1452" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1452" pageHeight="640" math="0" shadow="0"><root><mxCell id="p4-0"/><mxCell id="p4-table" value="Table" style="locked=1;" parent="p4-0"/><mxCell id="p4-sig" value="Signal" parent="p4-0"/><mxCell id="p4-1" value="2-2  Auto: prep start → wait for stable → supply → prep stop" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="10" y="8" width="1432" height="30" as="geometry"/></mxCell><mxCell id="p4-2" value="This chart answers: In auto mode the cleaner waits for stable before supplying: does a late stable DO slow the cycle?" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="40" width="1432" height="24" as="geometry"/></mxCell><mxCell id="p4-3" value="Legend: [I] cleaner / heater side premise   [IO] IO assignment   [P] this PLC proposal   [?] not decided   [OK] decided   |   red dashed box &quot;none&quot; = no reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p4-table"><mxGeometry x="10" y="66" width="1432" height="26" as="geometry"/></mxCell><mxCell id="p4-4" value="Group" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="0" y="96" width="112" height="64" as="geometry"/></mxCell><mxCell id="p4-5" value="Signal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="112" y="96" width="180" height="64" as="geometry"/></mxCell><mxCell id="p4-6" value="Notes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p4-table"><mxGeom