t="20" as="geometry"/></mxCell><mxCell id="p4-121" value="運転中" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=运转 · 入口阀 · 加热;kind=on;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="761" y="444" width="398" height="20" as="geometry"/></mxCell><mxCell id="p4-122" value="安定" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=安定（内部）;kind=green;fillColor=#548235;strokeColor=none;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p4-sig"><mxGeometry x="881" y="472" width="278" height="20" as="geometry"/></mxCell><mxCell id="p4-123" value="【注記】" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p4-table"><mxGeometry x="10" y="514" width="200" height="20" as="geometry"/></mxCell><mxCell id="p4-124" value="※1 自動モードでは洗浄機は安定 ON を待って投入開始に進む【定】ので、安定 DO が遅れるとそのまま投入が遅れる。読出周期は 3 s に決定済で、遅れは最大 3 s。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="536" width="1352" height="20" as="geometry"/></mxCell><mxCell id="p4-125" value="※2 温水器に送る内容は手動（2-1）と同じで、トリガのタイミングが違うだけ。送信後も同じく読み戻して照合する。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="556" width="1352" height="20" as="geometry"/></mxCell><mxCell id="p4-126" value="※3 弁の遅延パラメータ（準備開始 → 運転 ON、投入開始 → 排水弁閉、投入停止 → 投入弁閉）は図では省略【推】。" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p4-table"><mxGeometry x="14" y="576" width="1352" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-3-1" name="3-1 2 つのポーリング周期：洗浄機 500 ms、PLC 3 s"><mxGraphModel dx="1280" dy="514" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="514" math="0" shadow="0"><root><mxCell id="p5-0"/><mxCell id="p5-table" value="テーブル" style="locked=1;" parent="p5-0"/><mxCell id="p5-sig" value="信号" parent="p5-0"/><mxCell id="p5-1" value="3-1  2 つのポーリング周期：洗浄機 500 ms、PLC 3 s" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p5-table"><mxGeometry x="10" y="8" width="1260" height="30" as="geometry"/></mxCell><mxCell id="p5-2" value="この図で答えること：洗浄機は頻繁に、PLC はゆっくり読む。間をどうつなぐか／温水器の状態変化が洗浄機に見えるまでの時間" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p5-table"><mxGeometry x="10" y="40" width="1260" height="24" as="geometry"/></mxCell><mxCell id="p5-3" value="凡例：【推】洗浄機・温水器側の前提　【IO】IO 割付　【P】PLC 本案　【未】未定　【定】確定　｜　赤破線枠「無」= 応答なし" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p5-table"><mxGeometry x="10" y="66" width="1260" height="26" as="geometry"/></mxCell><mxCell id="p5-4" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p5-table"><mxGeometry x="0" y="96" width="100" height="64" as="geometry"/></mxCell><mxCell id="p5-5" value="信号" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p5-table"><mxGeometry x="100" y="96" width="160" height="64" as="geometry"/></mxCell><mxCell id="p5-6" value="備考" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p5-table"><mxGeometry x="260" y="96" width="300" height="64" as="geometry"/></mxCell><mxCell id="p5-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p5-table"><mxGeometry x="560" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p5-8" value="0 s" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p5-table"><mxGeometry x="560" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p5-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#fff