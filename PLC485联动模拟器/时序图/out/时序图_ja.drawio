" value="【P】洗浄機の現在の要求どおり再送：25.0 → 運転 OFF → 通水 OFF" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="260" y="496" width="300" height="28" as="geometry"/></mxCell><mxCell id="p9-74" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p9-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="524" as="sourcePoint"/><mxPoint x="1360" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-75" value="" style="rounded=0;fillColor=#fbe4d5;strokeColor=#ffffff;" vertex="1" parent="p9-table"><mxGeometry x="100" y="524" width="460" height="28" as="geometry"/></mxCell><mxCell id="p9-76" value="リセット" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="100" y="524" width="160" height="28" as="geometry"/></mxCell><mxCell id="p9-77" value="【P】エラーリセット + ブザーリセット" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo UI,Yu Gothic UI,Meiryo,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="260" y="524" width="300" height="28" as="geometry"/></mxCell><mxCell id="p9-78" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p9-table"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="552" as="sourcePoint"/><mxPoint x="1360" y="552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-79" value="" style="rounded=0;fillColor=#fff2cc;strokeColor=#ffffff;" vertex="1" parent="p9-table"><mxGeometry x="100" 