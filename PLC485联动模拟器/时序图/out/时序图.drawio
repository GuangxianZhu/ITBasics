ll id="p9-28" value="报警读取异常" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="92" y="186" width="140" height="26" as="geometry"/></mxCell><mxCell id="p9-29" value="【推】读报警失败 3 次 → 只显示" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="232" y="186" width="250" height="26" as="geometry"/></mxCell><mxCell id="p9-30" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p9-table"><mxGeometry relative="1" as="geometry"><mxPoint x="482" y="212" as="sourcePoint"/><mxPoint x="1282" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9-31" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p9-table"><mxGeometry x="92" y="212" width="390" height="26" as="geometry"/></mxCell><mxCell id="p9-32" value="运转 / 通水" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p9-table"><mxGeometry x="92" y="212" width="140" height="26" as="geometry"/></mxCell><mxCell id="p9-33" value="【推】看到重故障后 OFF" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p9-table"><mxGeometry x="232" y="212" width="250" height="26" as="geometry"/></mxCell><mxCell id="p9-34" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" pare