Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="340" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-51" value="[P] OFF on comm error" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="340" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-52" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="370" as="sourcePoint"/><mxPoint x="1532" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7-53" value="" style="rounded=0;fillColor=#e9e0f2;strokeColor=#ffffff;" vertex="1" parent="p7-table"><mxGeometry x="112" y="370" width="520" height="30" as="geometry"/></mxCell><mxCell id="p7-54" value="Read reply (alarm bits)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p7-table"><mxGeometry x="112" y="370" width="180" height="30" as="geometry"/></mxCell><mxCell id="p7-55" value="[P] keeps answering the cleaner during the link loss" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p7-table"><mxGeometry x="292" y="370" width="340" height="30" as="geometry"/></mxCell><mxCell id="p7-56" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p7-table"><mxGeometry relative