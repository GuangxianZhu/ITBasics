e;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="p1-sig"><mxGeometry x="833" y="494" width="198" height="22" as="geometry"/></mxCell><mxCell id="p1-120" value="25.0" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=su_st;sig=设定温度（内部）;kind=val;fillColor=#e2efda;strokeColor=#548235;fontColor=#548235;" vertex="1" parent="p1-sig"><mxGeometry x="873" y="524" width="158" height="22" as="geometry"/></mxCell><mxCell id="p1-121" value="Wait 30 s (no frames sent)" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;spacing=0;tl=bar;zone=plc;sig=启动等待;kind=val;fillColor=#f8d7d7;strokeColor=#c00000;fontColor=#c00000;" vertex="1" parent="p1-sig"><mxGeometry x="633" y="554" width="198" height="22" as="geometry"/></mxCell><mxCell id="p1-122" value="[Notes]" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p1-table"><mxGeometry x="10" y="598" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1-123" value="※1 If the cleaner's init temp write gets no reply 3 times, it raises &quot;comm init error&quot; and writes again after a reset on the screen [I]. The PLC uses its built-in Modbus slave: it replies to every write at once and keeps the value in cache, whether or not the heater is up, and forwards it once the heater is up [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="620" width="1024" height="38" as="geometry"/></mxCell><mxCell id="p1-124" value="※2 The heater accepts communication only 30 s after power-on [I]. Remote power ON / OFF goes from the cleaner into the PLC, and the PLC outputs it to the heater [IO]; so the PLC starts the 30 s timer when it forwards power ON and sends no frames during that time [P]. (The start point used to be flow ON; both signals turn ON together [OK], so using remote power itself is more direct, with the same result.)" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="658" width="1024" height="56" as="geometry"/></mxCell><mxCell id="p1-125" value="※3 While waiting, the cleaner is already reading alarms; the PLC answers all 0 (treated as normal). Only after 30 s, if 3 reads all get no reply, is it handled as a comm error (latched, needs reset) [P]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="714" width="1024" height="38" as="geometry"/></mxCell><mxCell id="p1-126" value="※4 The first status reply is checked for serial mode (the heater panel can switch local / remote / serial) [I]; if not serial → major fault [P, decided]." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="752" width="1024" height="20" as="geometry"/></mxCell><mxCell id="p1-127" value="※5 ACK only means &quot;received&quot;; the result has to be read back with a confirm command [I]. When the flow IO turns ON, the PLC does not forward flow yet; it sends it with run ON (see 2-1)." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="772" width="1024" height="38" as="geometry"/></mxCell><mxCell id="p1-128" value="※6 Major / minor fault DOs are NC (b) contacts: once the PLC program runs, it outputs &quot;normal&quot; (contact closed). If the PLC boots later than the cleaner, the cleaner sees a fault right at power-up, so the power-up order must be checked." style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#1f2937;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="p1-table"><mxGeometry x="14" y="810" width="1024" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="chart-1-2" name="1-2 Equipment end: remote power OFF → stop polling"><mxGraphModel dx="1152" dy="610" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1152" pageHeight="610" math="0" shadow="0"><root><mxCell id="p2-0"/><mxCell id="p2-table" value="Table" style="locked=1;" parent="p2-0"/><mxCell id="p2-sig" value="Signal" parent="p2-0"/><mxCell id="p2-1" value="1-2  Equipment end: remote power OFF → stop polling" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=18;fontColor=#1f3864;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="10" y="8" width="1132" height="30" as="geometry"/></mxCell><mxCell id="p2-2" value="This chart answers: When the heater's power is cut directly, how does the PLC avoid treating it as a link loss?" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="10" y="40" width="1132" height="24" as="geometry"/></mxCell><mxCell id="p2-3" value="Legend: [I] cleaner / heater side premise   [IO] IO assignment   [P] this PLC proposal   [?] not decided   [OK] decided   |   red dashed box &quot;none&quot; = no reply" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10;fontColor=#6b7280;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="10" y="66" width="1132" height="26" as="geometry"/></mxCell><mxCell id="p2-4" value="Group" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="0" y="96" width="112" height="64" as="geometry"/></mxCell><mxCell id="p2-5" value="Signal" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="112" y="96" width="180" height="64" as="geometry"/></mxCell><mxCell id="p2-6" value="Notes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=12;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="p2-table"><mxGeometry x="292" y="96" width="340" height="64" as="geometry"/></mxCell><mxCell id="p2-7" value="①" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="632" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-8" value="Idle" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="632" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-9" value="②" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="732" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-10" value="Equipment end (remote power OFF)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="732" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-11" value="③" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="832" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-12" value="Heater unpowered" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="832" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-13" value="④" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="932" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-14" value="Next equipment start (remote power ON)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="932" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-15" value="⑤" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=13;fillColor=#1f3864;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="1032" y="96" width="100" height="26" as="geometry"/></mxCell><mxCell id="p2-16" value="30 s passed · polling resumes" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI,Arial,sans-serif;fontSize=10.5;fillColor=#dde4f0;strokeColor=#ffffff;fontColor=#1f2937;align=center;verticalAlign=middle;" vertex="1" parent="p2-table"><mxGeometry x="1032" y="122" width="100" height="38" as="geometry"/></mxCell><mxCell id="p2-17" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p2-table"><mxGeometry x="112" y="160" width="520" height="30" as="geometry"/></mxCell><mxCell id="p2-18" value="Remote power OFF" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="112" y="160" width="180" height="30" as="geometry"/></mxCell><mxCell id="p2-19" value="[IO] into PLC; PLC passes it to the heater" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p2-table"><mxGeometry x="292" y="160" width="340" height="30" as="geometry"/></mxCell><mxCell id="p2-20" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p2-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="190" as="sourcePoint"/><mxPoint x="1132" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-21" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p2-table"><mxGeometry x="112" y="190" width="520" height="30" as="geometry"/></mxCell><mxCell id="p2-22" value="Remote power ON" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="112" y="190" width="180" height="30" as="geometry"/></mxCell><mxCell id="p2-23" value="[IO] same as above" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=9.5;fontColor=#4b5563;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;spacingTop=0;" vertex="1" parent="p2-table"><mxGeometry x="292" y="190" width="340" height="30" as="geometry"/></mxCell><mxCell id="p2-24" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="p2-table"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="220" as="sourcePoint"/><mxPoint x="1132" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-25" value="" style="rounded=0;fillColor=#ddebf7;strokeColor=#ffffff;" vertex="1" parent="p2-table"><mxGeometry x="112" y="220" width="520" height="30" as="geometry"/></mxCell><mxCell id="p2-26" value="Water flow" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Segoe UI,Arial,sans-serif;fontSize=11.5;fontColor=#111827;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=2;strokeColor=none;fillColor=none;" vertex="1" parent="p2-table"><mxGeometry x="112" y="220" width="180" height="30" as="geometry"/></mxCell><mxCell id="p2-27" value="[I] OFF / ON together with r